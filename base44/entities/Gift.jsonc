{
  "name": "Gift",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Client"
    },
    "customer_user_id": {
      "type": "string",
      "title": "Compte client"
    },
    "customer_name": {
      "type": "string",
      "title": "Pr\u00e9nom"
    },
    "customer_phone": {
      "type": "string",
      "title": "T\u00e9l\u00e9phone"
    },
    "earned_date": {
      "type": "string",
      "title": "Gagn\u00e9 le"
    },
    "flavors": {
      "type": "string",
      "title": "Saveurs choisies par l'\u00e9quipe"
    },
    "address_details": {
      "type": "string",
      "title": "Adresse de livraison"
    },
    "delivery_date": {
      "type": "string",
      "title": "Date de livraison"
    },
    "slot_label": {
      "type": "string",
      "title": "Cr\u00e9neau"
    },
    "status": {
      "type": "string",
      "title": "en_preparation / livre",
      "default": "en_preparation"
    },
    "team_seen": {
      "type": "boolean",
      "title": "Vu par l'\u00e9quipe",
      "default": false
    }
  },
  "required": [
    "customer_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}